{
  "name": "creai-mobile",
  "private": true,
  "version": "1.0.0",
  "description": "CreAI for iPhone and Android",
  "type": "module",
  "scripts": {
    "web": "node scripts/sync-web.mjs",
    "assets": "npx @capacitor/assets generate --iconBackgroundColor '#f4f1ea' --iconBackgroundColorDark '#101316' --splashBackgroundColor '#f4f1ea' --splashBackgroundColorDark '#101316'",
    "sync": "npm run web && npx cap sync",
    "android": "npm run sync && npx cap open android",
    "ios": "npm run sync && npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2"
  }
}
